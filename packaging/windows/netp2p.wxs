<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NetP2P" Language="1033" Version="$(var.ProductVersion)" Manufacturer="NetP2P" UpgradeCode="D6F5CF30-D0C0-4F2C-9E7B-8B1C3F5E6E4E" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NetP2P is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="NetP2P">
          <Component Id="DaemonFiles" Guid="8A5B31DE-6BC4-4EF1-B6F5-3AAB5E77E52E">
            <File Id="NetP2PD" Source="$(var.BinDir)\netp2pd.exe" KeyPath="yes" />
            <File Id="Wintun" Source="$(var.BinDir)\wintun.dll" />
          </Component>
          <Component Id="ServiceFiles" Guid="B2D83372-CBAE-42B4-90CE-1A47E2A2B3D4">
            <File Id="NetP2PCLI" Source="$(var.BinDir)\netp2p.exe" KeyPath="yes" />
            <File Id="TrayScript" Source="$(var.BinDir)\tray.ps1" />
            <ServiceInstall Id="NetP2PService" Name="NetP2PClient" Type="ownProcess" Start="auto" ErrorControl="normal" Arguments="service run --config [NETP2P_CONFIG]runtime.yaml" />
            <ServiceControl Id="NetP2PServiceControl" Name="NetP2PClient" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="NETP2P_CONFIG" Name="netp2p">
          <Component Id="ConfigFiles" Guid="6DC58065-9E5A-4E28-8F57-1D2E5A98DDB0">
            <File Id="RuntimeConfig" Source="$(var.BinDir)\runtime.yaml" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="TrayShortcut" Guid="3DEE1D9E-4AB6-4D32-99E7-CF2C91F6E3A2">
          <Shortcut Id="NetP2PTray" Name="NetP2P Tray" Target="[INSTALLDIR]netp2p.exe" Arguments="tray" WorkingDirectory="INSTALLDIR" />
          <RegistryValue Root="HKLM" Key="Software\NetP2P" Name="Tray" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Level="1">
      <ComponentRef Id="DaemonFiles" />
      <ComponentRef Id="ServiceFiles" />
      <ComponentRef Id="ConfigFiles" />
      <ComponentRef Id="TrayShortcut" />
    </Feature>
  </Package>
</Wix>
