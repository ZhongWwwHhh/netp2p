[Unit]
Description=NetP2P overlay client daemon
Documentation=https://github.com/ZhongWwwHhh/netp2p
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/netp2pd --role doctor --config-file /etc/netp2p/runtime.yaml
ExecStart=/usr/bin/netp2pd --config-file /etc/netp2p/runtime.yaml
Restart=on-failure
RestartSec=3

# TUN, DNS takeover, and the local IPC socket need elevated host access.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=netp2p
RuntimeDirectory=netp2p
ReadWritePaths=/var/lib/netp2p /run/netp2p /etc/resolv.conf

[Install]
WantedBy=multi-user.target
