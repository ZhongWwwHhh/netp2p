FROM --platform=$BUILDPLATFORM caddy:2-builder AS build
ARG TARGETOS
ARG TARGETARCH
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} xcaddy build --with github.com/caddy-dns/cloudflare@v0.2.4

FROM caddy:2
ARG VERSION=0.0.0-dev
LABEL org.opencontainers.image.title="NetP2P Caddy" \
      org.opencontainers.image.description="Caddy with the Cloudflare DNS module for NetP2P deployments" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/ZhongWwwHhh/netp2p" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /usr/bin/caddy /usr/bin/caddy
