FROM --platform=$BUILDPLATFORM caddy:2.10-builder@sha256:01668408cc26e2e00c9d067c30cb43b2ba14ad1f2808beda55503cb2a31f59dc AS build
ARG TARGETOS
ARG TARGETARCH
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} xcaddy build --with github.com/caddy-dns/cloudflare@v0.2.4

FROM caddy:2.10-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
ARG VERSION=0.0.0-dev
LABEL org.opencontainers.image.title="NetP2P Caddy" \
      org.opencontainers.image.description="Caddy with the Cloudflare DNS module for NetP2P deployments" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/ZhongWwwHhh/netp2p" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /usr/bin/caddy /usr/bin/caddy
